    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "cb2.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "bash ./build.sh",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {}
}
