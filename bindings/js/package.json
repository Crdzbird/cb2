{
  "name": "cb2",
  "version": "0.1.0",
  "description": "cb2 tokens for Node and browsers: the C ABI compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "./cb2.cjs",
  "module": "./src/cb2.js",
  "exports": {
    ".": {
      "import": "./src/cb2.js",
      "require": "./cb2.cjs"
    },
    "./core": "./dist/cb2_core.js",
